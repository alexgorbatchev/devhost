PATH_add "$(pwd)/apps/devhost/bin"

dotenv .env
dotenv_if_exists .env.local
# Native React DevTools: empty turns it off. Run `just dev-browser` and set this in .envrc.local to its endpoint,
# for example http://127.0.0.1:9222.
export DEVHOST_BROWSER_ENDPOINT=""

source_env_if_exists "./.envrc.local"
