#!/usr/bin/env bash

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_directory_path="$(cd "$(dirname "$script_path")" && pwd)"
package_root_path="$(cd "$script_directory_path/.." && pwd)"
compiled_binary_path="$package_root_path/dist/devhost"
source_entrypoint_path="$package_root_path/cmd/devhost"
original_working_directory_path="$(pwd)"

resolve_manifest_path() {
  local manifest_path="$1"
  if [[ "$manifest_path" = /* ]]; then
    printf '%s' "$manifest_path"
    return
  fi

  printf '%s/%s' "$original_working_directory_path" "$manifest_path"
}

resolved_args=()
while (($# > 0)); do
  case "$1" in
    --manifest)
      resolved_args+=("$1")
      shift
      if (($# > 0)); then
        resolved_args+=("$(resolve_manifest_path "$1")")
        shift
      fi
      ;;
    --manifest=*)
      resolved_args+=("--manifest=$(resolve_manifest_path "${1#--manifest=}")")
      shift
      ;;
    *)
      resolved_args+=("$1")
      shift
      ;;
  esac
done

# Execute the compiled binary only if it exists and is up-to-date with Go source files.
# If any Go source file is newer than the binary, fall back to running the source code directly via 'go run'.
if [[ -x "$compiled_binary_path" ]] && ! find "$package_root_path" -name "dist" -prune -o -name "*.go" -newer "$compiled_binary_path" -print | read -r; then
  exec "$compiled_binary_path" "${resolved_args[@]}"
fi

cd "$package_root_path"
exec env DEVHOST_SHIM_CWD="$original_working_directory_path" go run "$source_entrypoint_path" "${resolved_args[@]}"
