build-version := `bun -e 'const metadata = await Bun.file("./metadata.json").json(); console.log(metadata.version)'`
build-version-variable := "github.com/alexgorbatchev/devhost/apps/devhost/internal/version.buildVersion"

# Build embedded devtools bundle
build-devtools-bundle:
    bun run ./scripts/buildDevtoolsBundle.ts

# Compile devhost executable for the current platform
compile: build-devtools-bundle
    mkdir -p ./dist
    go build -trimpath -ldflags "-X {{build-version-variable}}={{build-version}}" -o ./dist/devhost ./cmd/devhost

# Fail on unformatted Go files, go vet findings, shadowed built-ins such as a variable named error, and module drift
lint: build-devtools-bundle
    #!/usr/bin/env bash
    set -euo pipefail
    unformatted="$(gofmt -l .)"
    if [ -n "${unformatted}" ]; then
        echo "gofmt is not clean, run 'just fix' from the repo root:" >&2
        echo "${unformatted}" >&2
        exit 1
    fi
    go vet ./...
    go tool predeclared ./...
    go mod tidy -diff

# Run Go formatting, vetting, module hygiene, and tests
check: lint
    bun test ./scripts/__tests__
    go test ./...

# Build versioned release archives
build-release-artifacts *args: build-devtools-bundle
    bun run ./scripts/buildReleaseArtifacts.ts {{args}}

# Start Neovim with playground project
nvim *args:
    bun run ./scripts/startNvim.ts {{args}}

# Run standalone React Highlight Neovim plugin tests
test-nvim:
    bun run ./internal/devtools/nvim/devhost-react-highlight.nvim/tests/run.ts
