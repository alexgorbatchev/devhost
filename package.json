{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun --bun oxfmt --check . && bun --bun oxlint . && bun run --cwd packages/devhost check && bun run --cwd packages/www check",
    "deploy:www": "bun ./scripts/deployWwwRailway.ts",
    "dev": "bun run --cwd packages/www devhost",
    "install-browser": "bun x playwright install chromium",
    "postinstall": "bun run install-browser",
    "storybook": "bun run --cwd packages/devhost storybook",
    "fix": "bun --bun oxfmt --write .",
    "prepare": "husky"
  },
  "nano-staged": {
    "*": "bun --bun oxfmt --write --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@alexgorbatchev/typescript-ai-policy": "^5.0.2",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0"
  }
}
