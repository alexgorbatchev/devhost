# Open the injected devtools UI design reference in the default browser
[macos]
devtools:
    open references/devtools.html

[linux]
devtools:
    xdg-open references/devtools.html

# Open the docs site design reference in the default browser
[macos]
docs:
    open references/docs.html

[linux]
docs:
    xdg-open references/docs.html

# Open the general design reference document in the default browser
[macos]
system:
    open references/design-system.html

[linux]
system:
    xdg-open references/design-system.html

# Check package-local validations (TypeScript and unit tests)
check:
    bun tsc --noEmit -p tsconfig.json
    bun test

# Regenerate tokens.css from src/constants.ts
write-tokens:
    bun scripts/writeTokensCss.ts
