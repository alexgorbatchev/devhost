# Run package-local checks (TypeScript, unused exports, unit and browser tests with coverage, Storybook tests in Chromium)
check:
    bun tsgo --noEmit -p tsconfig.json
    bun --bun x ts-unused tsconfig.json
    bun test --coverage
    bun vitest run -c vitest.browser.config.ts --coverage
    NODE_ENV=development bun vitest run -c vitest.storybook.config.ts

# Run the hook and `*.browser.test.ts` tests in Chromium, optionally limited to matching paths
test-browser *args:
    bun vitest run -c vitest.browser.config.ts {{args}}

# Ensure Playwright Chromium is available for Storybook
install-browser:
    bun playwright install chromium

# Start interactive Storybook dev server
storybook:
    bun storybook dev --ci --port 6006

# Run provisioned real native React acceptance from the repository root
[no-cd]
test-native-react:
    bun packages/devhost-ui/scripts/runNativeReactAcceptance.ts
