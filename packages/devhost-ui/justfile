# Run package-local checks (TypeScript, unused exports, unit, browser and Storybook tests, merged line coverage)
check: && test coverage
    bun tsgo --noEmit -p tsconfig.json
    bun --bun x ts-unused tsconfig.json

# Run the unit, browser and Storybook tests, each writing a coverage report
test:
    bun test --coverage --coverage-reporter=lcov --coverage-dir=.cache/coverage/unit
    bun vitest run -c vitest.browser.config.ts --coverage
    NODE_ENV=development bun vitest run -c vitest.storybook.config.ts --coverage

# Print the line coverage of the three test runs of the last `test` as one table; fail below the floor
coverage:
    bun scripts/lineCoverage/reportCoverage.ts --minimum-line-coverage 82 .cache/coverage/unit/lcov.info .cache/coverage/browser/lcov.info .cache/coverage/stories/lcov.info

# Run the hook and `*.browser.test.ts` tests in Chromium, optionally limited to matching paths
test-browser *args:
    bun vitest run -c vitest.browser.config.ts {{args}}

# Ensure Playwright Chromium is available for Storybook
install-browser:
    bun playwright install chromium

# Start interactive Storybook dev server
storybook:
    bun storybook dev --ci --port 6006

# Run provisioned real native React acceptance from the repository root
[no-cd]
test-native-react:
    bun packages/devhost-ui/scripts/runNativeReactAcceptance.ts
