# Record the real scenes and render the promo, or record one of startup/overview/annotations/query with captions
record scene="all":
    DEVHOST_DEMO_SCENE={{quote(scene)}} bun run ./recordDemo.ts

# Render the promo again from the footage of the latest recording, or of the given recording directory
promo recording="":
    DEVHOST_DEMO_RECORDING={{quote(recording)}} DEVHOST_DEMO_INVOCATION_DIRECTORY={{quote(invocation_directory())}} bun run ./renderPromo.ts

# Regenerate the promo's ElevenLabs narration; this bills the ELEVENLABS_API_KEY account
audio:
    bun run ./generatePromoAudio.ts

# Generate the guide films' ElevenLabs narration (one guide or all; keep unchanged lines' takes or retake them); this bills the ELEVENLABS_API_KEY account
audio-guides guide="all" takes="keep":
    DEVHOST_DEMO_GUIDE={{quote(guide)}} DEVHOST_DEMO_TAKES={{quote(takes)}} bun run ./generateGuideAudio.ts

# Render a guide's film again from the footage of its latest recording
guide-film guide:
    DEVHOST_DEMO_GUIDE={{quote(guide)}} bun run ./renderGuide.ts

# Run the recording workflow's behavioral tests
test:
    bun test ./__tests__

# Record and update the video, poster, captions, and transcript for each public guide
guides guide="all":
    DEVHOST_DEMO_GUIDE={{quote(guide)}} bun run ./recordGuides.ts
