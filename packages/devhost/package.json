{
  "name": "@alexgorbatchev/devhost",
  "version": "0.0.2",
  "description": "devhost is a CLI utility for local development that lets you open your local apps on HTTPS domains instead of raw localhost:port URLs, and can inject useful devtools directly into routed pages.",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgorbatchev/devhost.git"
  },
  "homepage": "https://github.com/alexgorbatchev/devhost#readme",
  "author": "Alex Gorbatchev",
  "license": "MIT",
  "scripts": {
    "build:devtools-bundle": "bun run ./scripts/buildDevtoolsBundle.ts",
    "build:release-artifacts": "bun run ./scripts/buildReleaseArtifacts.ts",
    "check": "./scripts/check.sh",
    "compile": "mkdir -p ./dist && bun run build:devtools-bundle && go build -trimpath -o ./dist/devhost ./cmd/devhost",
    "dev": "go run ./cmd/devhost",
    "devhost": "./bin/devhost",
    "fmt": "bun --bun oxfmt --write .",
    "storybook": "storybook dev --ci --port 6006"
  },
  "dependencies": {
    "@alexgorbatchev/dedent-string": "1.0.1",
    "@emotion/css": "^11.13.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "get-port": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/builder-vite": "10.3.5",
    "@storybook/react": "^10.3.5",
    "@storybook/react-dom-shim": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router": "^1.168.21",
    "@tanstack/router-devtools": "^1.166.13",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260408.1",
    "@vitest/browser-playwright": "4.1.4",
    "playwright": "1.59.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "10.3.5",
    "vite": "7.3.1",
    "vitest": "4.1.4"
  }
}
