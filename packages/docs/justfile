# Start local docs server with host 0.0.0.0
dev: sync media
    bun astro dev --host 0.0.0.0

# Alias for dev
start: dev

# Sync generated docs content from app README and examples
sync:
    bun sync.ts

# Download the pinned demo videos this checkout does not hold yet
media:
    bun demoMedia.ts fetch

# Upload new or re-rendered demo videos to the media release and pin them in demo-media.json
publish-media:
    bun demoMedia.ts publish

# Run docs unit tests
test: media
    bun test

# Build the static docs site
build: sync media
    bun astro build

# Check package-local validations
check: test sync
    bun demoMedia.ts verify
    bun astro check
    bun astro build

# Preview built static site
preview:
    bun astro preview --host 0.0.0.0
