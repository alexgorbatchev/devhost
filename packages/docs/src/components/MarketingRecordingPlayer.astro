---
import "rrweb-player/dist/style.css";

import { readResolvedRecordingUrl } from "./readResolvedRecordingUrl";

interface Props {
  recordingHeight: number;
  recordingLabel: string;
  recordingUrl: string;
  recordingWidth: number;
}

const { recordingHeight, recordingLabel, recordingUrl, recordingWidth }: Props = Astro.props;
const resolvedRecordingUrl: string = readResolvedRecordingUrl(import.meta.env.BASE_URL, recordingUrl);
---

<div
  class="MarketingRecordingPlayer not-content"
  data-recording-height={recordingHeight}
  data-recording-player-root
  data-recording-url={resolvedRecordingUrl}
  data-recording-width={recordingWidth}
  data-testid="MarketingRecordingPlayer"
>
  <div class="MarketingRecordingPlayer--status" data-recording-player-status data-testid="MarketingRecordingPlayer--status">
    Loading the {recordingLabel} replay…
  </div>
  <div class="MarketingRecordingPlayer--surface" data-recording-player-surface hidden data-testid="MarketingRecordingPlayer--surface">
    <div class="MarketingRecordingPlayer--stage" data-recording-player-stage></div>
  </div>
</div>

<script>
  import rrwebPlayer from "rrweb-player";
  import type { eventWithTime } from "@rrweb/types";
  import { registerMarketingRecordingPlayerLifecycle } from "./registerMarketingRecordingPlayerLifecycle";

  const playerHorizontalPaddingPx = 32;
  const fallbackControllerHeightPx = 80;

  interface IRrwebDemoRecording {
    durationMs: number;
    events: eventWithTime[];
  }

  interface IRecordingPlayerElements {
    stageElement: HTMLElement;
    statusElement: HTMLElement | null;
    surfaceElement: HTMLElement;
  }

  interface IResponsivePlayerLayout {
    playerHeightPx: number;
    scaledReplayHeightPx: number;
    scaledWidthPx: number;
    scale: number;
  }

  interface IRecordingPlayerState {
    controllerHeightPx: number;
    mutationObserver: MutationObserver;
    player: rrwebPlayer;
    playerHeight: number;
    playerWidth: number;
    resizeObserver: ResizeObserver;
  }

  type RecordingPlayerRoot = HTMLDivElement;

  const initializedPlayers = new WeakSet<RecordingPlayerRoot>();
  const pendingLayoutFrames = new WeakMap<RecordingPlayerRoot, number>();
  const playerObservers = new WeakMap<RecordingPlayerRoot, IntersectionObserver>();
  const playerStates = new WeakMap<RecordingPlayerRoot, IRecordingPlayerState>();

  for (const playerRoot of document.querySelectorAll<RecordingPlayerRoot>("[data-recording-player-root]")) {
    prepareRecordingPlayer(playerRoot);
  }

  function prepareRecordingPlayer(playerRoot: RecordingPlayerRoot): void {
    if (initializedPlayers.has(playerRoot)) {
      return;
    }

    if (isElementVisible(playerRoot)) {
      void initializeRecordingPlayer(playerRoot);
      return;
    }

    if (playerObservers.has(playerRoot)) {
      return;
    }

    const observer = new IntersectionObserver((entries: IntersectionObserverEntry[]): void => {
      const matchingEntry = entries.find((entry: IntersectionObserverEntry): boolean => {
        return entry.target === playerRoot;
      });

      if (!matchingEntry || (!matchingEntry.isIntersecting && !isElementVisible(playerRoot))) {
        return;
      }

      observer.disconnect();
      playerObservers.delete(playerRoot);
      void initializeRecordingPlayer(playerRoot);
    });

    playerObservers.set(playerRoot, observer);
    observer.observe(playerRoot);
  }

  async function initializeRecordingPlayer(playerRoot: RecordingPlayerRoot): Promise<void> {
    if (initializedPlayers.has(playerRoot)) {
      return;
    }

    initializedPlayers.add(playerRoot);

    const elements = readRecordingPlayerElements(playerRoot);
    const recordingUrl = playerRoot.dataset.recordingUrl;

    if (!elements || !recordingUrl) {
      initializedPlayers.delete(playerRoot);
      return;
    }

    try {
      const response = await fetch(recordingUrl);

      if (!response.ok) {
        throw new Error(`Request failed with status ${response.status}`);
      }

      const recordingJson: unknown = await response.json();
      const recording = readRrwebDemoRecording(recordingJson);
      const playerWidth = readDimension(playerRoot.dataset.recordingWidth, 1440);
      const playerHeight = readDimension(playerRoot.dataset.recordingHeight, 960);

      elements.stageElement.replaceChildren();
      elements.surfaceElement.hidden = false;
      elements.statusElement?.remove();

      const player = new rrwebPlayer({
        props: {
          autoPlay: true,
          events: recording.events,
          height: playerHeight,
          maxScale: 1,
          showController: true,
          width: playerWidth,
        },
        target: elements.stageElement,
      });

      const resizeObserver = new ResizeObserver((): void => {
        scheduleResponsivePlayerLayout(playerRoot);
      });

      const mutationObserver = new MutationObserver((): void => {
        scheduleResponsivePlayerLayout(playerRoot);
      });

      playerStates.set(playerRoot, {
        controllerHeightPx: fallbackControllerHeightPx,
        mutationObserver,
        player,
        playerHeight,
        playerWidth,
        resizeObserver,
      });

      resizeObserver.observe(elements.surfaceElement);
      mutationObserver.observe(elements.stageElement, { childList: true, subtree: true });

      registerMarketingRecordingPlayerLifecycle({
        player,
        scheduleResponsivePlayerLayout(): void {
          scheduleResponsivePlayerLayout(playerRoot);
        },
      });

      scheduleResponsivePlayerLayout(playerRoot);
    } catch (error) {
      initializedPlayers.delete(playerRoot);
      if (elements.statusElement) {
        elements.statusElement.hidden = false;
        elements.statusElement.textContent =
          error instanceof Error ? `Failed to load replay: ${error.message}` : "Failed to load replay.";
      }
    }
  }

  function isElementVisible(element: HTMLElement): boolean {
    return element.getClientRects().length > 0;
  }

  function isRrwebReplayEvent(value: unknown): value is eventWithTime {
    if (typeof value !== "object" || value === null) {
      return false;
    }

    const type = Reflect.get(value, "type");
    const timestamp = Reflect.get(value, "timestamp");

    return typeof type === "number" && typeof timestamp === "number" && Reflect.has(value, "data");
  }

  function readDimension(value: string | undefined, fallbackValue: number): number {
    if (value === undefined) {
      return fallbackValue;
    }

    const parsedValue = Number(value);
    return Number.isFinite(parsedValue) ? parsedValue : fallbackValue;
  }

  function readRecordingPlayerElements(playerRoot: RecordingPlayerRoot): IRecordingPlayerElements | null {
    const stageElement = playerRoot.querySelector<HTMLElement>("[data-recording-player-stage]");
    const statusElement = playerRoot.querySelector<HTMLElement>("[data-recording-player-status]");
    const surfaceElement = playerRoot.querySelector<HTMLElement>("[data-recording-player-surface]");

    if (!stageElement || !surfaceElement) {
      return null;
    }

    return { stageElement, statusElement, surfaceElement };
  }

  function readRrwebDemoRecording(value: unknown): IRrwebDemoRecording {
    if (typeof value !== "object" || value === null) {
      throw new Error("Recording payload must be an object.");
    }

    const durationMs = Reflect.get(value, "durationMs");
    const events = Reflect.get(value, "events");

    if (typeof durationMs !== "number" || !Array.isArray(events)) {
      throw new Error("Recording payload is missing rrweb events.");
    }

    return {
      durationMs,
      events: events.filter(isRrwebReplayEvent),
    };
  }

  function resolveResponsivePlayerLayout(options: {
    availableWidthPx: number;
    controllerHeightPx: number;
    playerHeight: number;
    playerWidth: number;
  }): IResponsivePlayerLayout {
    const playableWidthPx = Math.max(1, options.availableWidthPx - playerHorizontalPaddingPx);
    const scale = Math.min(playableWidthPx / options.playerWidth, 1);
    const scaledWidthPx = Math.round(options.playerWidth * scale);
    const scaledReplayHeightPx = Math.round(options.playerHeight * scale);
    const playerHeightPx = scaledReplayHeightPx + options.controllerHeightPx;

    return { playerHeightPx, scale, scaledReplayHeightPx, scaledWidthPx };
  }

  function updateResponsivePlayerLayout(playerRoot: RecordingPlayerRoot): void {
    const playerState = playerStates.get(playerRoot);
    const elements = readRecordingPlayerElements(playerRoot);

    if (!playerState || !elements) {
      return;
    }

    const playerElement = elements.stageElement.querySelector<HTMLElement>(".rr-player");
    const controllerElement = elements.stageElement.querySelector<HTMLElement>(".rr-controller");
    const playerFrameElement = elements.stageElement.querySelector<HTMLElement>(".rr-player__frame");
    const replayerWrapperElement = elements.stageElement.querySelector<HTMLElement>(".replayer-wrapper");

    if (!playerElement || !playerFrameElement || !replayerWrapperElement) {
      return;
    }

    playerState.controllerHeightPx = controllerElement?.offsetHeight ?? fallbackControllerHeightPx;

    const layout = resolveResponsivePlayerLayout({
      availableWidthPx: elements.surfaceElement.clientWidth,
      controllerHeightPx: playerState.controllerHeightPx,
      playerHeight: playerState.playerHeight,
      playerWidth: playerState.playerWidth,
    });

    elements.stageElement.style.height = `${layout.playerHeightPx}px`;
    elements.stageElement.style.width = `${layout.scaledWidthPx}px`;
    playerElement.style.float = "none";
    playerElement.style.height = `${layout.playerHeightPx}px`;
    playerElement.style.marginInline = "auto";
    playerElement.style.maxWidth = "none";
    playerElement.style.position = "relative";
    playerElement.style.transform = "none";
    playerElement.style.transformOrigin = "top left";
    playerElement.style.width = `${layout.scaledWidthPx}px`;
    playerFrameElement.style.height = `${layout.scaledReplayHeightPx}px`;
    playerFrameElement.style.width = `${layout.scaledWidthPx}px`;
    replayerWrapperElement.style.left = "0";
    replayerWrapperElement.style.top = "0";
    replayerWrapperElement.style.transform = `scale(${layout.scale})`;
    replayerWrapperElement.style.transformOrigin = "top left";
  }

  function scheduleResponsivePlayerLayout(playerRoot: RecordingPlayerRoot): void {
    const pendingLayoutFrame = pendingLayoutFrames.get(playerRoot);

    if (pendingLayoutFrame !== undefined) {
      cancelAnimationFrame(pendingLayoutFrame);
    }

    const animationFrame = requestAnimationFrame((): void => {
      const nestedAnimationFrame = requestAnimationFrame((): void => {
        pendingLayoutFrames.delete(playerRoot);
        updateResponsivePlayerLayout(playerRoot);
      });

      pendingLayoutFrames.set(playerRoot, nestedAnimationFrame);
    });

    pendingLayoutFrames.set(playerRoot, animationFrame);
  }
</script>

<style>
  .MarketingRecordingPlayer {
    --recording-player-active-color: #4950f6;
    --recording-player-border-color: var(--sl-color-gray-5);
    --recording-player-container-bg: var(--sl-color-black);
    --recording-player-controller-bg: #ffffff;
    --recording-player-controller-fg: #11103e;
    --recording-player-controller-muted: #d4d4d8;
    --recording-player-controller-shadow: 0 24px 48px rgba(17, 16, 62, 0.12);
    --recording-player-progress-bg: #eeeeee;
    --recording-player-progress-border: #ffffff;
    --recording-player-status-color: var(--sl-color-gray-2);
    --recording-player-switch-thumb: #fcfff4;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--recording-player-container-bg);
    overflow: hidden;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer) {
    --recording-player-border-color: var(--sl-color-gray-4);
    --recording-player-container-bg: #0f172a;
    --recording-player-controller-bg: #111827;
    --recording-player-controller-fg: #e5e7eb;
    --recording-player-controller-muted: #334155;
    --recording-player-controller-shadow: 0 24px 48px rgba(2, 6, 23, 0.48);
    --recording-player-progress-bg: #1f2937;
    --recording-player-progress-border: #111827;
    --recording-player-status-color: var(--sl-color-gray-3);
    --recording-player-switch-thumb: #f8fafc;
  }

  .MarketingRecordingPlayer--status {
    color: var(--recording-player-status-color);
    font-weight: 600;
    min-height: 28rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
  }

  .MarketingRecordingPlayer--surface {
    min-height: 28rem;
    overflow: hidden;
    padding: 1rem;
  }

  .MarketingRecordingPlayer--stage {
    display: grid;
    min-height: 28rem;
    place-items: start center;
    width: 100%;
  }

  .MarketingRecordingPlayer--surface :global(.rr-player) {
    background: var(--recording-player-controller-bg);
    box-shadow: var(--recording-player-controller-shadow);
    float: none;
    margin-inline: auto;
    position: relative;
  }

  .MarketingRecordingPlayer--surface :global(.rr-controller) {
    background: var(--recording-player-controller-bg) !important;
    color: var(--recording-player-controller-fg) !important;
  }

  .MarketingRecordingPlayer--surface :global(.rr-timeline__time) {
    color: var(--recording-player-controller-fg) !important;
  }

  .MarketingRecordingPlayer--surface :global(.rr-progress) {
    background: var(--recording-player-progress-bg) !important;
    border-top-color: var(--recording-player-progress-border) !important;
    border-bottom-color: var(--recording-player-progress-border) !important;
  }

  .MarketingRecordingPlayer--surface :global(.rr-progress__handler),
  .MarketingRecordingPlayer--surface :global(.rr-progress__step) {
    background: var(--recording-player-active-color) !important;
  }

  .MarketingRecordingPlayer--surface :global(.rr-controller button) {
    color: var(--recording-player-controller-fg) !important;
  }

  .MarketingRecordingPlayer--surface :global(.rr-controller button.active) {
    color: var(--recording-player-active-color) !important;
  }

  .MarketingRecordingPlayer--surface :global(.rr-controller button svg),
  .MarketingRecordingPlayer--surface :global(.rr-controller button svg path) {
    fill: currentColor !important;
  }

  .MarketingRecordingPlayer--surface :global(.switch label::before) {
    background: color-mix(in srgb, var(--recording-player-active-color) 50%, transparent) !important;
  }

  .MarketingRecordingPlayer--surface :global(.switch input[type="checkbox"]:checked + label::before) {
    background: var(--recording-player-active-color) !important;
  }

  .MarketingRecordingPlayer--surface :global(.switch label::after) {
    background: var(--recording-player-switch-thumb) !important;
  }

  .MarketingRecordingPlayer--surface :global(.switch .label) {
    color: var(--recording-player-controller-fg) !important;
  }

  .MarketingRecordingPlayer--surface :global(.rr-player__frame) {
    overflow: hidden;
  }

  .MarketingRecordingPlayer--surface :global(.replayer-wrapper) {
    left: 0;
    top: 0;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-player) {
    background: #ffffff !important;
    box-shadow: 0 24px 48px rgba(17, 16, 62, 0.12) !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-controller) {
    background: #ffffff !important;
    color: #11103e !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-timeline__time),
  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-controller .label),
  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-controller button) {
    color: #11103e !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-controller button.active) {
    color: #4950f6 !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-controller button svg),
  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-controller button svg path) {
    fill: currentColor !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-progress) {
    background: #eeeeee !important;
    border-top-color: #ffffff !important;
    border-bottom-color: #ffffff !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-progress__handler),
  :global(html[data-theme="light"] .MarketingRecordingPlayer .rr-progress__step) {
    background: #4950f6 !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .switch label::before) {
    background: rgba(73, 80, 246, 0.5) !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .switch input[type="checkbox"]:checked + label::before) {
    background: #4950f6 !important;
  }

  :global(html[data-theme="light"] .MarketingRecordingPlayer .switch label::after) {
    background: #fcfff4 !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-player) {
    background: #111827 !important;
    box-shadow: 0 24px 48px rgba(2, 6, 23, 0.48) !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-controller) {
    background: #111827 !important;
    color: #e5e7eb !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-timeline__time),
  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-controller .label),
  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-controller button) {
    color: #e5e7eb !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-controller button.active) {
    color: #818cf8 !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-controller button svg),
  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-controller button svg path) {
    fill: currentColor !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-progress) {
    background: #1f2937 !important;
    border-top-color: #111827 !important;
    border-bottom-color: #111827 !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-progress__handler),
  :global(html[data-theme="dark"] .MarketingRecordingPlayer .rr-progress__step) {
    background: #818cf8 !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .switch label::before) {
    background: rgba(129, 140, 248, 0.5) !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .switch input[type="checkbox"]:checked + label::before) {
    background: #818cf8 !important;
  }

  :global(html[data-theme="dark"] .MarketingRecordingPlayer .switch label::after) {
    background: #f8fafc !important;
  }
</style>
