---
import { CaptureRouteStatusSurface } from "../components/CaptureRouteStatusSurface";
import { CaptureSourceCardSurface } from "../components/CaptureSourceCardSurface";

interface ICaptureRouteParams {
  captureRoute: string;
}

interface ISourceLocation {
  columnNumber: number;
  componentName: string;
  fileName: string;
  lineNumber: number;
}

export function getStaticPaths(): { params: ICaptureRouteParams }[] {
  return [{ params: { captureRoute: "__capture__" } }];
}

const captureSourceLocation: ISourceLocation = {
  columnNumber: 1,
  componentName: "CaptureSourceCardSurface",
  fileName: "src/components/CaptureSourceCardSurface.tsx",
  lineNumber: 1,
};

const routeStatusSourceLocation: ISourceLocation = {
  columnNumber: 1,
  componentName: "CaptureRouteStatusSurface",
  fileName: "src/components/CaptureRouteStatusSurface.tsx",
  lineNumber: 1,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>devhost marketing capture</title>
    <style>
      :root {
        color-scheme: dark;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #020617;
        color: #e2e8f0;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at top, rgba(59, 130, 246, 0.18), transparent 34%),
          linear-gradient(180deg, #020617 0%, #0f172a 100%);
      }

      .marketingCapturePage {
        margin: 0 auto;
        max-width: 1220px;
        padding: 48px 24px 180px;
      }

      .captureHero,
      .captureCard,
      .captureScrollSection {
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 24px;
        background: rgba(15, 23, 42, 0.72);
        box-shadow: 0 24px 80px rgba(15, 23, 42, 0.34);
        backdrop-filter: blur(18px);
      }

      .captureHero {
        padding: 32px;
      }

      .captureLabel {
        margin: 0 0 12px;
        color: #93c5fd;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      h1 {
        font-size: clamp(2.8rem, 6vw, 4.8rem);
        line-height: 0.95;
      }

      .captureHero p:last-child {
        margin-top: 18px;
        color: #cbd5e1;
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 64ch;
      }

      .captureGrid {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.9fr);
        gap: 20px;
        margin-top: 24px;
      }

      .captureColumn {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .captureCard {
        padding: 24px;
      }

      .captureCard h2,
      .captureCard h3 {
        margin-top: 10px;
        font-size: 1.1rem;
      }

      .captureCard p,
      .captureCard li,
      .captureSourceMetadata dt,
      .captureSourceMetadata dd {
        color: #cbd5e1;
        line-height: 1.6;
      }

      .captureActionRow {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-top: 20px;
      }

      .captureActionTarget {
        border: 1px solid rgba(96, 165, 250, 0.35);
        border-radius: 20px;
        background: linear-gradient(180deg, rgba(30, 41, 59, 0.96), rgba(15, 23, 42, 0.92));
        padding: 22px;
      }

      .captureActionTarget strong,
      .captureRouteStatus strong {
        display: block;
        margin-bottom: 6px;
      }

      .captureRouteStatus {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .captureRouteButton {
        align-self: flex-start;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
        color: #eff6ff;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
        padding: 12px 18px;
      }

      .captureRouteButton[disabled] {
        cursor: wait;
        filter: saturate(0.2);
        opacity: 0.7;
      }

      .captureServiceList {
        display: grid;
        gap: 10px;
        list-style: none;
        margin: 18px 0 0;
        padding: 0;
      }

      .captureServiceRow {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        border-radius: 16px;
        background: rgba(15, 23, 42, 0.88);
        padding: 14px 16px;
      }

      .captureServicePill {
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 4px 10px;
      }

      .captureServicePill[data-status="healthy"] {
        background: rgba(34, 197, 94, 0.18);
        color: #86efac;
      }

      .captureServicePill[data-status="degraded"] {
        background: rgba(248, 113, 113, 0.16);
        color: #fca5a5;
      }

      .captureSourceCard {
        min-height: 230px;
      }

      .captureSourceMetadata {
        display: grid;
        gap: 10px;
        margin-top: 18px;
      }

      .captureSourceMetadata div {
        display: flex;
        justify-content: space-between;
        gap: 12px;
      }

      .captureSourceMetadata dt {
        font-weight: 700;
      }

      .captureSourceMetadata dd {
        margin: 0;
        text-align: right;
      }

      .captureScrollSection {
        margin-top: 24px;
        overflow: hidden;
        padding: 24px;
      }

      .captureScrollRail {
        display: grid;
        gap: 16px;
        padding-top: 8px;
      }

      .captureScrollItem {
        border-radius: 18px;
        background: rgba(15, 23, 42, 0.88);
        padding: 18px;
      }

      .captureScrollItem p:last-child {
        margin-top: 8px;
        color: #cbd5e1;
      }

      @media (max-width: 940px) {
        .captureGrid,
        .captureActionRow {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <devhost-capture-demo data-project-root-path="/capture-demo" data-stack-name="www-marketing-capture">
      <main class="marketingCapturePage" data-testid="MarketingCapturePage">
        <section class="captureHero">
          <p class="captureLabel">Marketing recorder host</p>
          <h1>Capture the real devhost devtools UI.</h1>
          <p>
            This page restores the deterministic demo surface used by the marketing recorder. It exposes stable DOM
            targets, a mocked control plane, and a browser rrweb capture API for Playwright-driven recording runs.
          </p>
        </section>

        <section class="captureGrid">
          <div class="captureColumn">
            <article class="captureCard">
              <p class="captureLabel">Annotation focus targets</p>
              <h2>Two annotated callouts</h2>
              <p>
                Alt-click the cards below to showcase annotation selection, then submit an agent handoff through the
                injected composer.
              </p>
              <div class="captureActionRow">
                <section
                  class="captureActionTarget"
                  data-devhost-cursor="pointer"
                  id="capture-annotation-target-primary"
                  data-testid="MarketingCapturePage--annotation-target-primary"
                >
                  <strong>Primary target</strong>
                  <p>Move the launch command rail below the health summary and tighten the spacing.</p>
                </section>
                <section
                  class="captureActionTarget"
                  data-devhost-cursor="pointer"
                  id="capture-annotation-target-secondary"
                  data-testid="MarketingCapturePage--annotation-target-secondary"
                >
                  <strong>Secondary target</strong>
                  <p>Align the worker-service warning with the rest of the capture grid before the next take.</p>
                </section>
              </div>
            </article>

            <CaptureSourceCardSurface client:load source={captureSourceLocation} />
          </div>

          <div class="captureColumn">
            <CaptureRouteStatusSurface client:load source={routeStatusSourceLocation} />

            <article class="captureCard">
              <p class="captureLabel">Service snapshot</p>
              <h3>Current stack health</h3>
              <ul class="captureServiceList">
                <li class="captureServiceRow">
                  <span>app.localhost</span>
                  <span class="captureServicePill" data-status="healthy">healthy</span>
                </li>
                <li class="captureServiceRow">
                  <span>api.localhost</span>
                  <span class="captureServicePill" data-status="healthy">healthy</span>
                </li>
                <li class="captureServiceRow">
                  <span>worker.localhost</span>
                  <span class="captureServicePill" data-status="degraded">degraded</span>
                </li>
              </ul>
            </article>
          </div>
        </section>

        <section class="captureScrollSection" data-testid="MarketingCapturePage--scroll-section">
          <p class="captureLabel">Scroll choreography</p>
          <h2>Long-form capture notes</h2>
          <div class="captureScrollRail">
            <article class="captureScrollItem">
              <strong>Step 1</strong>
              <p>Bring the overlay into view and pause long enough for the minimap and status panels to settle.</p>
            </article>
            <article class="captureScrollItem">
              <strong>Step 2</strong>
              <p>Focus the source card, launch an editor session, and let the terminal tray animate into place.</p>
            </article>
            <article class="captureScrollItem">
              <strong>Step 3</strong>
              <p>Use the route reveal button to transition from the pending route state to the live route state.</p>
            </article>
            <article class="captureScrollItem">
              <strong>Step 4</strong>
              <p>Keep enough vertical content here to make slow scroll gestures visible in the final rrweb recording.</p>
            </article>
          </div>
        </section>
      </main>
    </devhost-capture-demo>

    <script src="../scripts/devhostCaptureDemo.ts"></script>
  </body>
</html>
